# Salin ke .env.local lalu isi. JANGAN commit .env.local.
# Nilai ada di Supabase Dashboard > Project Settings > API Keys (atau tombol "Connect").

# --- Aman untuk browser (prefix NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) atau legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Rahasia, hanya server. Jangan pernah dipakai di komponen client ---
# Secret key (sb_secret_...) / legacy service_role. Isi hanya jika benar-benar perlu (mis. seeding).
SUPABASE_SECRET_KEY=
